@model IReadOnlyList<SceneActivitySummary>
@{ ViewData["Title"] = "場景與籤池"; }
<section class="page-heading"><div><p class="eyebrow">SCENE ACTIVITIES</p><h1>場景與籤池</h1><p>設定玩家可選擇的籤名、隱藏效果與戲文字數門檻。</p></div></section>
<div class="notice-card"><strong>隱藏效果規則</strong><p>玩家抽籤前只能看到籤名，不得取得加成內容；完成抽籤後才由後端回傳該次結果。</p></div>
<section class="card-grid">
@foreach (var location in Model.GroupBy(item => item.LocationName)) {
    var pools = location.OrderBy(item => item.MinimumApprovedWords).ToArray();
    var published = pools.All(item => item.Status == "published");
    <article class="scene-card location-card">
        <div class="scene-symbol">@location.Key[..1]</div>
        <div class="scene-main">
            <div class="card-meta"><span class="status @(published ? "published" : "draft")">@(published ? "已發布" : "含草稿")</span><code>@pools.Length 個籤池</code></div>
            <h2>@location.Key</h2>
            <p>同一場所下的活動與籤池</p>
        </div>
        <dl>
            <div><dt>活動數</dt><dd>@pools.Length</dd></div>
            <div><dt>啟用籤數</dt><dd>@pools.Sum(item => item.EnabledOptionCount) / @pools.Sum(item => item.OptionCount)</dd></div>
            <div><dt>最高版本</dt><dd>v@pools.Max(item => item.Version)</dd></div>
        </dl>
        <div class="scene-pool-list">
        @foreach (var item in pools) {
            <a asp-action="Edit" asp-route-id="@item.Id">
                <span><strong>@item.DisplayName</strong><small>@item.AttendantLabel · 門檻 @item.MinimumApprovedWords 字</small></span>
                <em>@item.EnabledOptionCount / @item.OptionCount 支籤</em>
            </a>
        }
        </div>
    </article>
}
</section>
