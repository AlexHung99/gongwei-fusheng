@model IReadOnlyList<RankApplicationOptionRow>
@{
    ViewData["Title"] = "位號設定";
    string RoleLabel(string role) => role switch { "consort" => "嬪妃", "prince" => "皇子", "princess" => "帝姬", _ => role };
}

<section class="page-heading">
    <div><p class="eyebrow">RANK MANAGEMENT</p><h1>位號設定</h1><p>查詢、新增、修改或刪除嬪妃、皇子與帝姬位號。</p></div>
    <a class="button primary" asp-action="Create">新增位號</a>
</section>

<div class="notice-card">
    <strong>資料安全規則</strong>
    <p>已被角色或審核紀錄使用的位號不會從資料庫硬刪除；點選「刪除」會停用位號並移出建角選單，歷史資料仍保留。</p>
</div>

<section class="panel table-panel">
    <div class="table-tools">
        <div class="rank-filter-controls">
            <select data-rank-role-filter aria-label="依角色身份篩選">
                <option value="">全部身份</option>
                <option value="consort">嬪妃</option>
                <option value="prince">皇子</option>
                <option value="princess">帝姬</option>
            </select>
            <input data-table-filter placeholder="搜尋品級、位號或代碼" aria-label="搜尋位號" />
        </div>
        <span data-filter-count data-total="@Model.Count">顯示 @Model.Count / @Model.Count 個位號</span>
    </div>
    <div class="table-scroll">
        <table>
            <thead><tr><th>身份</th><th>品級／位號</th><th>門檻／月俸</th><th>初始能力</th><th>建角</th><th>狀態</th><th>版本</th><th>操作</th></tr></thead>
            <tbody data-filter-target>
            @foreach (var rank in Model)
            {
                <tr class="rank-option-row" data-role="@rank.Role">
                    <td><strong>@RoleLabel(rank.Role)</strong></td>
                    <td><strong>@rank.GradeCode・@rank.DisplayName</strong><small><code>@rank.Code</code></small></td>
                    <td>威望 @rank.PrestigeRequired.ToString("N0")<small>月俸 @rank.MonthlyStipend.ToString("N0")</small></td>
                    <td>體 @rank.Vitality／容 @rank.Appearance／心 @rank.Strategy／福 @rank.Luck</td>
                    <td><span class="status @(rank.IsApplicationOption ? "published" : "draft")">@(rank.IsApplicationOption ? "可選" : "不提供")</span></td>
                    <td><span class="status @(rank.IsActive ? "published" : "draft")">@(rank.IsActive ? "啟用" : "已刪除")</span></td>
                    <td>v@rank.Version</td>
                    <td><a class="text-button rank-edit-link" asp-action="Edit" asp-route-id="@rank.Id">查看／編輯</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
